@{
    ViewData["Title"] = "Home Page";
    var sessionExpired = Context.Request.Query["sessionExpired"].ToString();
}

<div class="text-center">
    <h1 class="display-4">Room Of Doom</h1>
    <p class="lead">Welcome to the Room of Doom, where you can manage your repair backlog.</p>
</div>

@if (!string.IsNullOrEmpty(sessionExpired) && sessionExpired == "true")
{
    <div class="alert alert-warning" role="alert">
        Your session has expired. Please log in again.
    </div>
}

<div class="text-center">
    <h2>Login</h2>
    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Login with your account</a>
</div>
