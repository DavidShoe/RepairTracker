@{
    ViewData["Title"] = "Home Page";
    var sessionExpired = Context.Request.Query["sessionExpired"].ToString();
}

<div class="text-center">
    <h1 class="display-4">Room Of Doom</h1>
    <p class="lead">Welcome to the Room of Doom, where you can manage your repair backlog.</p>
</div>

@if (!string.IsNullOrEmpty(sessionExpired) && sessionExpired == "true")
{
    <div class="alert alert-warning" role="alert">
        Your session has expired. Please log in again.
    </div>
}

<div class="text-center">
    <h2>Login</h2>
    <form id="loginForm" method="post">
        <div class="form-group">
            <label for="userType">I am a:</label>
            <select id="userType" class="form-control" onchange="toggleLoginFields()">
                <option value="">Select...</option>
                <option value="technician">Technician</option>
                <option value="customer">Customer</option>
            </select>
        </div>
        <div id="technicianFields" style="display:none;">
            <div class="form-group">
                <label for="technicianName">Technician Name</label>
                <input type="text" id="techName" name="techName" class="form-control" />
            </div>
            <div class="form-group">
                <label for="technicianPassword">Password</label>
                <input type="password" id="password" name="password" class="form-control" />
            </div>

            <div class="form-group">
                <button type="button" onclick="login('/API/LoginTech')" class="btn btn-primary">Tech Login</button>
            </div>
        </div>
        <div id="customerFields" style="display:none;">
            <div class="form-group">
                <label for="customerLogin">Customer Login</label>
                <input type="text" id="userName" name="userName" class="form-control" />
            </div>
            <div class="form-group">
                <label for="technicianPassword">Password</label>
                <input type="password" id="userPassword" name="userPassword" class="form-control" />
            </div>

            <div class="form-group">
                <button type="button" onclick="login('/API/LoginOwner')" class="btn btn-primary">User Login</button>
            </div>
        </div>
    </form>
    <div id="errorMessage" class="text-danger" style="display:none;"></div>
</div>

@section Scripts {
    <script>
        function toggleLoginFields() {
            var userType = document.getElementById("userType").value;
            var technicianFields = document.getElementById("technicianFields");
            var customerFields = document.getElementById("customerFields");

            if (userType === "technician") {
                technicianFields.style.display = "block";
                customerFields.style.display = "none";
            } else if (userType === "customer") {
                technicianFields.style.display = "none";
                customerFields.style.display = "block";
            } else {
                technicianFields.style.display = "none";
                customerFields.style.display = "none";
            }
        }

        function login(actionUrl) {
            var formData = new FormData(document.getElementById("loginForm"));
            var xhr = new XMLHttpRequest();
            xhr.open("POST", actionUrl, true);
            xhr.onload = function () {
                if (xhr.status === 200) {
                    var response = JSON.parse(xhr.responseText);
                    window.location.href = response.redirectUrl;
                } else {
                    var errorMessage = document.getElementById("errorMessage");
                    errorMessage.innerText = xhr.responseText;
                    errorMessage.style.display = "block";
                }
            };
            xhr.send(formData);
        }
    </script>
}
