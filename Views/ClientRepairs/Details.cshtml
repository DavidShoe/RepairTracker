@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Tech")] // Only Admins and Technicians can access


@model RepairTracker.DBModels.Repair

@{
    ViewData["Title"] = "Repair Details";
}
<div>
    <h1>Repair Details</h1>
    @await Html.PartialAsync("_RepairHeaderPartialView", Model)
</div>
<hr />

<div>
    <div>
        <h3>Work performed</h3>
    </div>

    <table class="table items-table" id="Notes">
        <thead>
            <tr class="row">
                <th class="col-md-2">
                    Work Date
                </th>
                <th class="col-md-8">
                    Work Description
                </th>
            </tr>
        </thead>
        <tbody>
            @await Html.PartialAsync("_NotesTablePartialView", Model.RepairNotes)
        </tbody>
    </table>
</div>

<hr />

<div>
    <h3>Parts used</h3>
    <table class="table items-table" id="partsUsed">
        <thead>
            <tr>
                <th>
                    Part
                </th>
                <th>
                    Sale $
                </th>
                <th>
                    Quantity
                </th>
                <th>
                    Line Total$
                </th>
            </tr>
        </thead>
        <tbody>
            @await Html.PartialAsync("_PartsUsedTablePartialView", Model.RepairParts)
        </tbody>
    </table>
</div>


<a asp-action="Index">Back to List</a>
